# Copy to /etc/netweather/vpn-invariants.env on the production VPS.
# This file is host-owned and must never contain secrets.

VPN_PUBLIC_IP=203.0.113.10
NETWEATHER_DOMAIN=netweather.example

VPN_VLESS_ENABLED=1
VPN_XRAY_CONTAINER=whitelist-xray
VPN_XRAY_LOOPBACK_PORT=18080

VPN_AWG_ENABLED=1
VPN_AWG_CONTAINER=amnezia-awg2
VPN_AWG_INTERFACE=awg0
VPN_AWG_PUBLIC_UDP_PORT=443
VPN_AWG_BACKEND_UDP_PORT=35404
VPN_AWG_REQUIRE_REDIRECT=1
