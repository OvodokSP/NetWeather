#!/usr/bin/env bash
set -Eeuo pipefail

command -v nft >/dev/null
SUBNET="172.30.250.0/28"

# Independent table: it does not alter Docker, nginx, Xray, AWG or other VPN rules.
nft delete table inet netweather_guard 2>/dev/null || true
nft -f - <<EOF
table inet netweather_guard {
  set forbidden4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8,
      10.0.0.0/8,
      100.64.0.0/10,
      127.0.0.0/8,
      169.254.0.0/16,
      172.16.0.0/12,
      192.0.0.0/24,
      192.0.2.0/24,
      192.168.0.0/16,
      198.18.0.0/15,
      198.51.100.0/24,
      203.0.113.0/24,
      224.0.0.0/4,
      240.0.0.0/4
    }
  }

  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr ${SUBNET} ct state established,related counter accept
    ip saddr ${SUBNET} counter drop
  }

  chain forward {
    type filter hook forward priority -10; policy accept;
    ip saddr ${SUBNET} ip daddr @forbidden4 counter drop
  }
}
EOF
