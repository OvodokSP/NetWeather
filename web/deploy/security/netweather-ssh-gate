#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ORIGINAL="${SSH_ORIGINAL_COMMAND:-}"
if [[ "${ORIGINAL}" =~ ^deploy[[:space:]]+([0-9a-f]{40})$ ]]; then
  SHA="${BASH_REMATCH[1]}"
  exec sudo -n /usr/local/sbin/netweather-deploy-helper "${SHA}"
fi

logger -t netweather-deploy "rejected deploy-key command"
echo "This SSH key is restricted to NetWeather image deployment." >&2
exit 126
