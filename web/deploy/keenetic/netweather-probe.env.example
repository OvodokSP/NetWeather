# Stored on Keenetic as /opt/etc/netweather-probe.env with mode 0600.
# Never commit the real token.
NETWEATHER_URL=https://netweather.online
NETWEATHER_AGENT_TOKEN=
NETWEATHER_PROBE_KEY=RU_VORONEZH_HOME
NETWEATHER_PROBE_NAME='Домашний Keenetic Воронеж'
NETWEATHER_AGENT_VERSION=0.3.10
NETWEATHER_PROBE_INTERVAL=60
NETWEATHER_DIRECT_INTERFACE=eth2.4
CURL_BIN=/opt/bin/curl
TRACEROUTE_BIN=traceroute
