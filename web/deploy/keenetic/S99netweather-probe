#!/opt/bin/sh
set -u

NAME="netweather-probe"
PROBE="/opt/sbin/netweather-probe"
ENV_FILE="/opt/etc/netweather-probe.env"
PID_FILE="/opt/var/run/netweather-probe.pid"
STATE_DIR="/opt/var/run/netweather-probe"
LOG_FILE="/opt/var/log/netweather-probe.log"

load_env() {
  [ -r "$ENV_FILE" ] || { echo "$NAME: missing $ENV_FILE" >&2; return 1; }
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
}

running_pid() {
  [ -r "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  command_line="$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  case "$command_line" in
    *"$PROBE"*) ;;
    *) rm -f "$PID_FILE"; return 1 ;;
  esac
  printf '%s' "$pid"
}

start() {
  if pid="$(running_pid)"; then
    echo "$NAME already running (pid $pid)"
    return 0
  fi
  [ -x "$PROBE" ] || { echo "$NAME: missing executable $PROBE" >&2; return 1; }
  load_env || return 1
  mkdir -p "$(dirname "$PID_FILE")" "$STATE_DIR" "$(dirname "$LOG_FILE")"
  NETWEATHER_STATE_DIR="$STATE_DIR" nohup "$PROBE" >>"$LOG_FILE" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"
  sleep 2
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "$NAME failed to start; last log lines:" >&2
    tail -n 20 "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    return 1
  fi
  echo "$NAME started (pid $pid)"
}

stop() {
  if ! pid="$(running_pid)"; then
    rm -f "$PID_FILE"
    echo "$NAME is not running"
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 10 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "$NAME did not stop within 10 seconds" >&2
    return 1
  fi
  rm -f "$PID_FILE"
  echo "$NAME stopped"
}

status() {
  if ! pid="$(running_pid)"; then
    echo "$NAME is stopped"
    return 1
  fi
  last="$(cat "$STATE_DIR/last-success" 2>/dev/null || true)"
  now="$(date +%s)"
  if [ -n "$last" ]; then
    age=$((now - last))
    echo "$NAME is running (pid $pid), last successful cycle ${age}s ago"
    [ "$age" -le 180 ] || return 2
  else
    echo "$NAME is running (pid $pid), no successful cycle yet"
    return 2
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 64 ;;
esac
